{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        http-kit/http-kit   {:mvn/version "2.8.1"}
        metosin/jsonista    {:mvn/version "1.0.2"}
        metosin/malli       {:mvn/version "0.20.3"}
        hiccup/hiccup       {:mvn/version "2.0.0"}}
 :aliases
 {:dev  {:extra-paths ["dev" "test"]}       ; test/ for the test scenarios (prize, hamlet)
  :run  {:main-opts ["-m" "manor.main"]}
  :cache {:main-opts ["-m" "manor.tools.cache-report"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["-Xmx2g"]
         :main-opts ["-m" "manor.test-runner"]
         :exec-fn manor.test-runner/test}}}
