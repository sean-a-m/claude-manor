;; Basic temperament axes and definitions. Behaviour is written by the character model.
{:levels [:low :average :high],
 :axes
 [{:axis :openness,
   :measures
   "curiosity, imagination, willingness to entertain new ideas"}
  {:axis :conscientiousness,
   :measures "self-control, diligence, attention to detail"}
  {:axis :extraversion, :measures "boldness, energy, sociability"}
  {:axis :agreeableness,
   :measures "kindness, helpfulness, willingness to cooperate"}
  {:axis :neuroticism, :measures "irritability, anxiety, low spirits"}]}
