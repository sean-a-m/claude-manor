  {:name "Pocock" :sex :male :role :baker :location "bakers-shop" :bedroom "bakers-lodgings"
   :situation "You keep the baker's shop on Claudeworth's village green, with the bakehouse behind it, and live above it. You are up before dawn to fire the oven and bake the day's bread."
   :routine [{:from "04:30" :at "bakers-shop" :doing "firing the oven and baking the day's bread"}
