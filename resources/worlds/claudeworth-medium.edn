  {:id "card-table" :name "Card table" :place "drawing-room" :owner "household" :fixed? true :desc "A folding rosewood card table with a green baize top, opened out for whist after dinner."}
  {:id "tea-table" :name "Tea table" :place "drawing-room" :owner "household" :fixed? true :desc "A low round table with a tilting top, where the tea tray is set down in the afternoon."}
