  {:id "family-portrait" :name "Family portrait" :place "dining-room" :owner "household" :fixed? true :aspects {:repair "darkened with old varnish"} :desc "A gloomy full-length portrait of the first baron in a powdered wig, in a heavy gilt frame, hung facing the table."}
  {:id "sideboard" :name "Sideboard" :place "dining-room" :owner "household" :fixed? true :container :closed :aspects {:cleanliness "polished" :repair "a ring mark on the top"} :desc "A long mahogany sideboard with cupboards below for the table linen."}
