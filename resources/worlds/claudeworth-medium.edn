;; Claudeworth Manor, the medium household: the fresh world every
;; :claudeworth-medium run starts from. A template: nothing writes to it.
;; Runs keep a copy (world-start.edn) and export their live map (map.edn) in
;; this format. See docs/household-1904-proposal.md: the Barons of Claudeworth
;; have lately come into ironstone royalties and mean to enlarge the house.
;; The village and the abbey are the same places as in the :claudeworth world.
{:meta {:name "Claudeworth Manor"
        :start "1904-10-15T08:00"
        :minutes-per-round 30
        :starting-funds 2900 ; whole pounds here; runtime money is old pence
        :positions "positions/england-1904.edn"
        :architect-prices "architect/prices-1904-medium.edn" ; the sizes and prices Pugh's firm quotes
        :setting "Claudeworth Manor is a Jacobean country house with a Georgian front, the seat of the Barons of Claudeworth: comfortable, plainly kept and too small for the family's station, which the baron means to mend now that the ironstone quarry on the estate has begun to pay. Claudeworth village lies by its gates, a sloping green with shops, a public house, a post office, a forge and tradespeople working from their cottages, as well as the offices of Pugh & Sons, Architects. Hollin Abbey is nearby too, where the monks keep to themselves."}

 :locations
 [;; ------------------------------------------------ the house (comfortable, and too small)
  {:id "carriage-sweep" :name "Carriage sweep" :domain :house :floor :outside :kind :approach
   :connects-to ["entrance-hall" "stable-yard"]
   :desc "A gravel turning circle before the front door, the stable yard behind it and the drive running down to the village."}
  {:id "entrance-hall" :name "Entrance hall" :domain :house :floor :ground :kind :hall
   :aspects {:cleanliness "dust in the corners" :state "hearth swept, fire unlit"}
   :connects-to ["drawing-room" "dining-room" "library" "morning-room" "staircase" "back-passage"]
   :desc "A panelled hall with a fireplace, a longcase clock and a stag's head over the mantel. The family rooms open off it, and the baize door at the back leads to the servants' part of the house."
   :detail "Two tall windows light the floor, and the family's walking sticks stand in a stand by the door. The baize door is heavy, green and worn pale at the edges where shoulders and trays have pushed it open."}
  {:id "drawing-room" :name "Drawing room" :domain :house :floor :ground :kind :sitting-room
   :aspects {:cleanliness "dusty, with ash by the fender" :state "hearth cold"}
   :desc "A long room with tall windows onto the lawn, chintz chairs and the piano. There is room for a dozen at tea, and no more."
   :detail "Faded blue wallpaper, a white marble chimneypiece and a carpet worn thin where people walk to the window. The good chairs are kept for visitors, and the family keeps to the ends of the room."}
  {:id "dining-room" :name "Dining room" :domain :house :floor :ground :kind :dining-room
   :aspects {:cleanliness "floor swept, cobwebs above the cornice" :state "hearth laid but unlit"}
   :desc "A mahogany table for ten, with the family portraits looking down on it and the sideboard behind the baron's chair."}
  {:id "library" :name "Library" :domain :house :floor :ground :kind :study
   :aspects {:cleanliness "dust on the skirting boards" :state "air close with stale pipe smoke"}
   :desc "The baron's business room: a leather-topped desk, the estate ledgers and the quarry papers, with a window on the drive."
   :detail "Shelves of county histories and bound agricultural reports nobody reads, and the estate map pinned above the grate with the quarry land shaded in. From the desk you can see every caller come up the drive."}
  {:id "morning-room" :name "Morning room" :domain :house :floor :ground :kind :sitting-room
   :aspects {:cleanliness "tidy, with dust on the window ledge" :state "hearth cold"}
   :desc "The baroness's own room: a writing desk, a work basket by the fire and a window over the rose beds. Her letters and the household books are kept here."
   :detail "A low ceiling and a good light. On the desk stand the household account book, a pot of pens and a photograph of three sisters on a lawn."}
  {:id "back-passage" :name "Back passage" :domain :house :floor :ground :kind :passage
   :aspects {:cleanliness "boards swept"}
   :connects-to ["kitchen" "scullery" "pantry" "butlers-pantry" "boot-room" "back-stairs"]
   :desc "A flagged passage behind the baize door, joining the kitchen, the pantry and the servants' stair, with the boot-and-lamp room at its end."}
  {:id "kitchen" :name "Kitchen" :domain :house :floor :ground :kind :kitchen
   :aspects {:cleanliness "flour dust on the floor" :state "air cold"}
   :connects-to ["scullery" "pantry" "butlers-pantry" "boot-room"]
   :desc "A high old kitchen with a cast-iron range, a broad worktable and a dresser. The staff eat their meals here; there is no servants' hall. The scullery, the pantry and the butler's pantry open off it."
   :detail "Copper pans on the dresser, a long scrubbed table with a bench each side, and a chair drawn up to the range for the cook. The bell board is by the door, so every ring from the family rooms is heard here first."}
  {:id "scullery" :name "Scullery" :domain :house :floor :ground :kind :scullery
   :aspects {:cleanliness "floor wet, sink in need of scouring"}
   :desc "A plain workroom off the kitchen, with a deep stone sink, a draining board and room for washing pots and peeling vegetables."}
  {:id "pantry" :name "Pantry" :domain :house :floor :ground :kind :pantry
   :aspects {:cleanliness "floor swept" :state "cool and dry"}
   :desc "A cool dry larder with slate shelves, a meat safe and a window shaded from the sun. The household's provisions are kept here, and the cook keeps the key."}
  {:id "butlers-pantry" :name "Butler's pantry" :domain :house :floor :ground :kind :pantry
   :aspects {:cleanliness "polished" :state "plate locked in the safe"}
   :connects-to ["butlers-room"]
   :desc "Mr Merrick's own room: a table for silver and glass, a sink, and the safe where the plate is kept. A small inner room opens off it, where he sleeps within call of the front door."}
  {:id "butlers-room" :name "Butler's room" :domain :house :floor :ground :kind :bedroom
   :aspects {:cleanliness "swept, with dust under the bed"}
   :desc "A narrow room off the butler's pantry with an iron bed, a washstand and a chest. The butler-valet sleeps here, with the plate on the other side of the wall and the front door beyond that."}
  {:id "boot-room" :name "Boot-and-lamp room" :domain :house :floor :ground :kind :room
   :aspects {:cleanliness "mud on the flags" :state "lamps trimmed and filled"}
   :desc "A lean-to at the end of the back passage where boots, knives and lamps are cleaned and coals and wood are kept for the fires."}
  {:id "back-stairs" :name "Back stairs" :domain :house :floor :ground :kind :stair
   :aspects {:cleanliness "dust along the treads"}
   :connects-to ["attic-landing"]
   :desc "A plain deal staircase behind the baize door, rising from the back passage to the servants' rooms in the attic."}
  {:id "staircase" :name "Staircase" :domain :house :floor :ground :kind :stair
   :aspects {:cleanliness "dust along the stair edges"}
   :connects-to ["gallery"]
   :desc "The family's oak staircase, creaking on the fourth step, from the hall to the gallery."}
  {:id "gallery" :name "First-floor gallery" :domain :house :floor :first :kind :landing
   :aspects {:cleanliness "dust on the banisters"}
   :connects-to ["barons-bedroom" "barons-dressing-room" "baroness-bedroom" "daughters-room" "sons-room" "guest-bedroom" "linen-room"]
   :desc "A long landing hung with family portraits, the bedroom doors opening off it and the linen room at the far end. There is one water-closet in the house, off this landing."
   :detail "The portraits are of eighteenth-century Claudeworths in wigs and hunting dress, and the frames are better than the paintings. At night a single lamp is left burning on the half-landing, and the passage beyond the linen room is unlit."}
  {:id "barons-bedroom" :name "Baron's bedroom" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "carpet brushed, dust behind the curtains" :state "hearth cold"}
   :connects-to ["barons-dressing-room"]
   :desc "A large room with a heavy four-poster, a tall wardrobe and a window over the park. There is no bath in the house: water is carried up in cans and poured into a hip bath before the fire."
   :detail "The bed curtains are old but sound, and the carpet is worn in a path from the bed to the window. A shelf of estate and railway reports stands by the bed, and the baron reads them at night when the accounts worry him."}
  {:id "barons-dressing-room" :name "Baron's dressing room" :domain :house :floor :first :kind :room
   :aspects {:cleanliness "brushes and razors in order"}
   :desc "A small room between the bedroom and the gallery, with a press for the baron's clothes and a stand for his razors, where he dresses and is shaved."}
  {:id "baroness-bedroom" :name "Baroness's bedroom" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "tidy, with dust on the window ledge" :state "hearth cold"}
   :desc "A bright room with a dressing table, a day bed and a window over the garden, next door to her daughter's room."}
  {:id "daughters-room" :name "Daughter's room" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "tidy, the bed made"}
   :desc "A young lady's room beside her mother's: a white bed, a writing table, a chest of drawers and a shelf of novels and fashion papers."}
  {:id "sons-room" :name "Son's room" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "aired and swept, nobody in it"}
   :desc "A boy's room under the eaves, with a narrow bed, a press and a shelf of schoolbooks. Master Claudeworth is away at school and the room is kept aired for the holidays."}
  {:id "guest-bedroom" :name "Guest bedroom" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "dusted, bed aired"}
   :desc "The one spare room: a brass bed, a washstand and a print of the abbey over the fireplace. The baroness's sisters are put here when they come, and there is nowhere else to put anybody."}
  {:id "linen-room" :name "Linen room" :domain :house :floor :first :kind :room
   :aspects {:cleanliness "shelves wiped" :state "press stocked with the household's linen"}
   :desc "A dry room at the end of the gallery, with shelves for sheets, towels and the family's spare blankets, and the linen press against the wall."}
  {:id "attic-landing" :name "Attic landing" :domain :house :floor :attic :kind :landing
   :aspects {:cleanliness "boards swept"}
   :connects-to ["cooks-room" "ladys-maids-room" "housemaids-room" "kitchen-maids-room" "box-room"]
   :desc "A narrow passage under the slates at the top of the back stairs, the servants' doors opening off it and a skylight over the stairwell."
   :detail "The boards are bare and the roof slopes so that a tall person must stoop at the ends. A candle is kept on the sill of the skylight for whoever comes up last."}
  {:id "cooks-room" :name "Cook's room" :domain :house :floor :attic :kind :bedroom
   :aspects {:cleanliness "neatly kept, washstand wiped"}
   :desc "Mrs Thorne's room: an iron bed, a washstand and a chair by the skylight, with a chest for her things and a shelf for her brother's letters from Grimsby."}
  {:id "ladys-maids-room" :name "Lady's maid's room" :domain :house :floor :attic :kind :bedroom
   :aspects {:cleanliness "swept, sewing things in order"}
   :desc "Miss Nash's room, with a bed, a chest of drawers and a table by the window for her sewing, mending and the baroness's ribbons."}
  {:id "housemaids-room" :name "Housemaids' room" :domain :house :floor :attic :kind :bedroom
   :aspects {:cleanliness "swept, with dust beneath the chests"}
   :desc "A plain room with two iron beds, a chest apiece and a window over the back yard. The head housemaid and the housemaid share it."}
  {:id "kitchen-maids-room" :name "Kitchen maid's room" :domain :house :floor :attic :kind :bedroom
   :aspects {:cleanliness "swept, with dust beneath the chest"}
   :desc "A slip of a room under the eaves with one narrow bed, a chest and a peg for an apron."}
  {:id "box-room" :name "Box room" :domain :house :floor :attic :kind :room
   :aspects {:cleanliness "dust on the stored boxes"}
   :desc "The attic lumber room: travelling trunks, spare bedding, the Christmas decorations and a disused rocking horse, with the tin hip bath propped against the wall. It is the obvious place to make another servant's bedroom when the beds are wanted."}
  ;; ------------------------------------------------ outside: the yard, stables and garden
  {:id "stable-yard" :name "Stable yard" :domain :house :floor :outside :kind :yard
   :aspects {:cleanliness "straw and muck by the stable door"}
   :connects-to ["stables" "coach-house" "kitchen-garden"]
   :desc "A cobbled yard behind the house, the stables on one side and the coach house on the other, with a gate onto the lane."}
  {:id "stables" :name "Stables" :domain :house :floor :ground :kind :stable
   :aspects {:cleanliness "straw swept to the walls"}
   :desc "Three stalls and a loose box, with the two horses and the pony in work, and hay and straw kept in the loft above."}
  {:id "coach-house" :name "Coach house" :domain :house :floor :ground :kind :coach-house
   :aspects {:cleanliness "floor swept, harness on its pegs"}
   :connects-to ["coachmans-lodgings"]
   :desc "The coach house, where the brougham and the dog-cart stand, with the coachman's rooms over the top and the smell of harness and linseed oil through both."}
  {:id "coachmans-lodgings" :name "Coachman's lodgings" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "swept, fire laid"}
   :desc "Mr Ridley's rooms over the coach house: a bed-sitting room with a good fire, a table, and a window over the yard where he can see who comes and goes."}
  {:id "kitchen-garden" :name "Kitchen garden" :domain :house :floor :outside :kind :garden
   :aspects {:cleanliness "paths raked, beds in order"}
   :connects-to ["glasshouse" "gardeners-cottage"]
   :desc "A walled garden of beds and fruit trees behind the stables, with a glasshouse against the south wall and the gardener's cottage at the gate."}
  {:id "glasshouse" :name "Glasshouse" :domain :house :floor :ground :kind :glasshouse
   :aspects {:cleanliness "glass wiped, pots watered"}
   :desc "A lean-to glasshouse on the south wall, with a vine, a peach tree and pots of cuttings for the house."}
  {:id "gardeners-cottage" :name "Gardener's cottage" :domain :house :floor :ground :kind :bedroom
   :aspects {:cleanliness "kitchen scrubbed, bed aired"}
   :desc "Mr Durrant's cottage at the garden gate: a kitchen and a bedroom under the tiles, with his boots by the door and seed catalogues on the dresser."}

;; ------------------------------------------------ Claudeworth village
  ;; ------------------------------------------------ Claudeworth village
  {:id "village-green" :name "Village green" :domain :village :kind :green
   :connects-to ["general-store" "butchers-shop" "drapers-shop" "public-house" "post-office" "forge"
                 "sweeps-cottage" "barbers-cottage" "laundress-cottage" "labourers-cottage" "architects-office"]
   :desc "A sloping green with a pump, an old market cross and geese. The shops face it."}
  {:id "general-store" :name "General store" :domain :village :kind :shop :hours ["08:00" "18:00"]
   :services #{:general-store}
   :store-profile "A modest village general store in rural England, 1904. Everyday household necessities: groceries in small packages, dry goods, haberdashery, stationery, and simple domestic tools. These examples describe its scope, not an exhaustive inventory. Not a department store or specialist dealer. Only portable goods sold over the counter."
   :delivery-profile "Orders too large to carry away, and goods in the shop's line that can be got in from town, are sent up to houses in the neighbourhood."
   :courier :carrier
   :connects-to ["store-lodgings"]
   :desc "Groceries, candles, household necessities and gossip, sold over one long counter by Mr Briggs."
   :detail "Shelves to the ceiling of tins, jars and bolts of cloth, sacks of flour and meal along the floor, and a smell of paraffin and cheese. The bell over the door announces every customer, and the counter is where the village's news changes hands."}
  {:id "store-lodgings" :name "Shopkeeper's lodgings" :domain :village :kind :bedroom
   :desc "A snug room above the general store, with a brass bed and a kettle by the grate."}
  {:id "butchers-shop" :name "Butcher's shop" :domain :village :kind :shop :hours ["08:00" "18:00"]
   ;; :general-store enables the existing counter-and-quote service; the profile defines the trade.
   :services #{:general-store}
   :store-profile "A small village butcher's shop in rural England, 1904. Fresh beef, mutton, lamb and pork in ordinary household cuts, offal, sausages, bacon and bones for stock, wrapped for customers to carry away. These examples describe the trade, not an exhaustive inventory. No general groceries, household tools, live animals, whole carcasses or credit. Only portable purchases handed over the counter."
   :delivery-profile "Larger orders, more than a customer can carry, are sent up to houses in the neighbourhood."
   :connects-to ["butchers-lodgings"]
   :desc "Hobbs, Butcher: a small shop facing the green, with a scrubbed counter and joints hanging from hooks behind it."
   :detail "White tiles, a heavy chopping block, brass scales and a roll of wrapping paper. Mr Hobbs cuts and weighs meat at the counter; a cool back room keeps the day's stock out of the sun."}
  {:id "butchers-lodgings" :name "Butcher's lodgings" :domain :village :kind :bedroom
   :desc "Mr Hobbs's rooms above the butcher's shop, with a plain bed and a sitting room overlooking the green."}
  {:id "drapers-shop" :name "Draper's shop" :domain :village :kind :shop :hours ["08:00" "18:00"]
   :services #{:general-store}
   :store-profile "A village draper in rural England, 1904. Cloth by the yard, calico, flannel, dress lengths, household linen, ribbons, thread, buttons and other haberdashery, with a modest range of ready-made hosiery. These examples describe the trade, not an exhaustive inventory. Portable goods over the counter only; no bespoke dressmaking service, furniture or general groceries."
   :delivery-profile "Larger parcels in the drapery trade, too much for a customer to carry away, are sent up to houses in the neighbourhood."
   :connects-to ["drapers-lodgings"]
   :desc "Miss Ellis's drapery faces the green: a narrow shop with cloth measured out on a long counter and ribbons in the window."
   :detail "Shelves of folded calico and flannel rise behind the counter. A brass yard measure is let into its edge; drawers below hold buttons and small haberdashery. The window light is softened by lengths of lace curtain."}
  {:id "drapers-lodgings" :name "Draper's lodgings" :domain :village :kind :bedroom
   :desc "A neat bedroom above the drapery, with a patchwork coverlet and a window looking across the green."}
  {:id "public-house" :name "The Crown public house" :domain :village :kind :public-house :hours ["11:00" "22:00"]
   :services #{:general-store}
   :store-profile "A small fully licensed village public house in rural England, 1904. Beer, ale, porter, cider and modest measures of spirits, with bread and cheese or other simple cold refreshments. These examples describe its scope, not an exhaustive menu. Only portable food and drink handed over the bar; not a grocer, hotel or restaurant. No room bookings, rounds on credit or paid hospitality services."
   :connects-to ["publicans-room" "barmaids-room"]
   :desc "The Crown: a low, whitewashed public house, with a taproom opening from the green and a private stair behind the bar. The publican keeps it with a barmaid who lives in; there is no guest accommodation."
   :detail "Dark settles stand against the walls, the floor is flagged, and a small serving hatch opens towards the cellar stair. A painted crown hangs above the door; frosted lower panes screen the taproom from the green."}
  {:id "publicans-room" :name "Publican's room" :domain :village :kind :bedroom
   :desc "A plain bedroom above the Crown, with a washstand and a heavy woollen blanket on the bed. There are no guest rooms."}
  {:id "barmaids-room" :name "Barmaid's room" :domain :village :kind :bedroom
   :desc "A narrow attic room under the Crown's eaves, with an iron bedstead, a chest of drawers and a small square window over the yard."}
  {:id "post-office" :name "Post office" :domain :village :kind :office :hours ["08:00" "18:00"]
   :services #{:general-store :post-office}
   :store-profile "A small village sub-post office in rural England, 1904. Edward VII postage stamps, stamped postcards, envelopes, writing paper and other modest postal stationery, sold as portable goods at the counter. These examples describe the stock, not an exhaustive inventory. No sale of postal orders, savings deposits or telegraph services through this goods counter; no money transfers or mechanically dispatched letters or parcels."
   :connects-to ["postmistress-room"]
   :desc "Mrs Bell keeps the sub-post office in the front room of a brick cottage. A red pillar box stands by the door, and a glazed counter separates callers from the sorting shelves."
   :detail "A portrait of Edward VII hangs above the counter. Pigeonholes line the back wall, with printed postal notices and a clock beside them. There is no telegraph instrument here; telegram enquiries must go to the town office."}
  {:id "postmistress-room" :name "Postmistress's room" :domain :village :kind :bedroom
   :desc "Mrs Bell's quiet bedroom behind the post office, with a small grate and a curtained window onto the garden."}
  {:id "forge" :name "Blacksmith's forge" :domain :village :kind :workshop :hours ["07:00" "18:00"]
   :services #{:blacksmith}
   :connects-to ["blacksmiths-room"]
   :aspects {:cleanliness "coal dust on the floor" :state "hearth banked"}
   :desc "Mr Carter's smithy stands at the edge of the green, its wide doors opening onto a shoeing space. He makes and repairs ironwork, tools and farm fittings as well as shoeing horses."
   :detail "A brick forge hood rises towards the tiled roof. The stone floor is dark with scale, and the doorway gives room to work on awkward lengths of iron. This is a village smithy, not a motor engineer's or a watch repairer's shop."}
  {:id "blacksmiths-room" :name "Blacksmith's room" :domain :village :kind :bedroom
   :desc "A small bedroom in the cottage adjoining the smithy, with a sturdy bed and a washstand by the back window."}
  {:id "sweeps-cottage" :name "Chimney sweep's cottage" :domain :village :kind :cottage :hours ["07:00" "18:00"]
   :services #{:chimney-sweep}
   :connects-to ["sweeps-room"]
   :desc "Mr Rudge's cottage has a little front workroom where callers can arrange a chimney sweeping. He works with jointed rods and brushes, not climbing children."
   :detail "The limewashed workroom opens straight from the lane beside the green. A stone threshold and a dark patch by the back door show where sooty equipment is brought in; the sleeping room is kept apart from the work."}
  {:id "sweeps-room" :name "Chimney sweep's room" :domain :village :kind :bedroom
   :desc "A simple bedroom behind the sweep's workroom, with a narrow bed and a small chest of clean clothes."}
  {:id "barbers-cottage" :name "Barber's cottage" :domain :village :kind :cottage :hours ["08:00" "19:00"]
   :services #{:barber}
   :connects-to ["barbers-room"]
   :desc "Mr Webb works as a barber and hairdresser in the front room of his cottage. A striped pole marks the door; villagers come for a shave or a haircut."
   :detail "A mirror faces the window across a plain wooden chair with a headrest. The floor is bare boards, easily swept, and a little hearth warms the room. It is a small village barber's, not a fashionable ladies' salon."}
  {:id "barbers-room" :name "Barber's room" :domain :village :kind :bedroom
   :desc "A tidy bedroom upstairs at the barber's cottage, with a washstand and a faded print above the bed."}
  {:id "laundress-cottage" :name "Laundress's cottage" :domain :village :kind :cottage :hours ["07:00" "18:00"]
   :services #{:laundry}
   :connects-to ["laundress-room"]
   :aspects {:cleanliness "flags scrubbed" :state "washhouse aired"}
   :desc "Mrs Dobbins takes in washing at her cottage, with a washhouse behind it and a small drying yard. Villagers bring bundles of linen to be washed, starched and ironed."
   :detail "The front workroom has space for sorting and folding linen; a rear doorway leads to the brick-floored washhouse. Lines cross the yard, and an airing rack hangs high under the washhouse rafters. There is no powered laundry machinery."}
  {:id "laundress-room" :name "Laundress's room" :domain :village :kind :bedroom
   :desc "A small bedroom upstairs, away from the steam of the washhouse, with a patchwork quilt and a chest beside the bed."}
  {:id "architects-office" :name "Architect's office" :domain :village :kind :office :hours ["09:00" "18:00"]
   :services #{:architect}
   :connects-to ["architects-lodgings"]
   :desc "Pugh & Sons, Architects: a front room of drawing boards, plan chests and shelves of reference books."}
  {:id "architects-lodgings" :name "Architect's lodgings" :domain :village :kind :bedroom
   :desc "Rooms above the office, comfortable and cluttered with rolled plans."}
  {:id "labourers-cottage" :name "Labourer's cottage" :domain :village :kind :bedroom
   :aspects {:cleanliness "flags scrubbed"}
   :desc "Two rooms and a scullery under a slate roof, one of a pair of cottages behind the green, where Alf lives with his mother and his sisters."}

  ;; ------------------------------------------------ Hollin Abbey
  {:id "abbey-gatehouse" :name "Abbey gatehouse" :domain :abbey :kind :gatehouse
   :connects-to ["abbey-church" "abbey-guest-house"]
   :desc "The old stone gatehouse of Hollin Abbey, its porter's bell on a chain. A painted board beside the arch directs visitors to the guest house, where the guestmaster receives them."}
  {:id "abbey-church" :name "Abbey church" :domain :abbey :kind :church
   :desc "Hollin Abbey's church, cool and quiet. The monks keep to themselves and sing the offices here; visitors who want a word with one of them ask at the guest house by the gatehouse."}
  {:id "abbey-guest-house" :name "Abbey guest house" :domain :abbey :kind :guest-house
   :services #{:hospitality}
   :connects-to ["guestmasters-cell"]
   :desc "A plain stone parlour inside the gatehouse court, where the abbey's guestmaster receives callers, pilgrims and anyone seeking counsel."
   :detail "A scrubbed oak table, a few rush-seated chairs and a crucifix on the whitewashed wall. A shelf holds a visitors' book, a Bible and a jug of water with two cups."}
  {:id "guestmasters-cell" :name "Guestmaster's cell" :domain :abbey :kind :bedroom
   :desc "A monk's bare cell off the guest house: a narrow bed, a prie-dieu and a single shelf of books."}]

 ;; journeys: [from to rounds], two-way; one round is half an hour
 :routes [["carriage-sweep" "village-green" 1]
