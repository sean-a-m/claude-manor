  {:id "china-cabinet" :name "China cabinet" :place "drawing-room" :owner "household" :fixed? true :container :open :aspects {:cleanliness "dusty, the glass smeared"} :desc "A glass-fronted walnut cabinet on slender legs, for the family's porcelain."}
  {:id "meissen-shepherdess" :name "Meissen shepherdess" :in "china-cabinet" :owner "household" :aspects {:cleanliness "dusty"} :desc "A porcelain shepherdess in a flowered gown, with a crook and a lamb at her feet."}
