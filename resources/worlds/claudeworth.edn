;; Claudeworth Manor: the fresh world every :claudeworth run starts from.
;; A template: nothing writes to it. Runs keep a copy (world-start.edn) and
;; export their live map (map.edn) in this format. See docs/claudeworth-design.md.
{:meta {:name "Claudeworth Manor"
        :start "1904-10-15T08:00"
        :minutes-per-round 30
        :starting-funds 3000 ; whole pounds here; runtime money is old pence
        :starting-stores {"provisions" 2}
        :setting "Claudeworth Manor is a modest Edwardian country house, the seat of the Earls of Claudeworth, whose fortune has lately been restored. Claudeworth village lies nearby, a sloping green with a general store, a butcher's shop and the offices of Pugh & Sons, Architects. Hollin Abbey is nearby too, where the monks keep to themselves."}

 :locations
 [;; ------------------------------------------------ the manor (small to begin with)
  {:id "carriage-sweep" :name "Carriage sweep" :domain :house :floor :outside :kind :approach
   :connects-to ["entrance-hall"]
   :desc "A gravel turning circle before the front door."}
  {:id "entrance-hall" :name "Entrance hall" :domain :house :floor :ground :kind :hall
   :connects-to ["drawing-room" "study" "dining-room" "kitchen" "staircase"]
   :desc "A modest hall with a fireplace. Doors lead to the principal rooms and the kitchen, with the bedrooms upstairs."}
  {:id "drawing-room" :name "Drawing room" :domain :house :floor :ground :kind :sitting-room
   :desc "A pleasant room with chintz chairs, though four guests would crowd it."
   :detail "Faded rose wallpaper, a white marble chimneypiece and two tall windows onto the lawn. The chintz is worn thin on the arms of the best chair, and the carpet has been turned to hide a scorch mark by the fender."}
  {:id "study" :name "Study" :domain :house :floor :ground :kind :study
   :desc "The earl's business room: a leather-topped desk and a view of the drive."
   :detail "Shelves of county histories and bound sermons that nobody reads, a map of the estate pinned above the fireplace, and a smell of pipe smoke and old leather. From the desk you can see every caller coming up the drive."}
  {:id "dining-room" :name "Dining room" :domain :house :floor :ground :kind :dining-room
   :desc "A mahogany table for eight, laid for breakfast."}
  {:id "kitchen" :name "Kitchen" :domain :house :floor :ground :kind :kitchen
   :connects-to ["maids-room" "pantry" "scullery"]
   :desc "An old kitchen with a cast-iron range, a broad worktable and a dresser. Mrs Finch, the cook, runs it; the pantry and scullery open off it."}
  {:id "pantry" :name "Pantry" :domain :house :floor :ground :kind :pantry
   :desc "A cool pantry off the kitchen, with wooden shelves for the household's provisions and a small window shaded from the sun."}
  {:id "scullery" :name "Scullery" :domain :house :floor :ground :kind :scullery
   :desc "A plain workroom off the kitchen, with a deep stone sink, a draining board and room for washing pots and peeling vegetables."}
  {:id "maids-room" :name "Maid's room" :domain :house :floor :ground :kind :bedroom
   :desc "A small room off the kitchen: a narrow bed, a chest of drawers and a window on the yard."}
  {:id "staircase" :name "Staircase" :domain :house :floor :ground :kind :stair
   :connects-to ["gallery"]
   :desc "A narrow oak staircase, creaking on the fourth step."}
  {:id "gallery" :name "First-floor gallery" :domain :house :floor :first :kind :landing
   :connects-to ["earls-bedroom" "countess-bedroom" "secretarys-room" "servants-landing"]
   :desc "A short landing hung with watercolours, the bedroom doors opening off it."}
  {:id "earls-bedroom" :name "Earl's bedroom" :domain :house :floor :first :kind :bedroom
   :desc "A large bed with heavy curtains, a washstand and a dressing room no bigger than a cupboard."}
  {:id "countess-bedroom" :name "Countess's bedroom" :domain :house :floor :first :kind :bedroom
   :desc "A bright room with a dressing table, a writing desk and a window over the garden."}
  {:id "secretarys-room" :name "Secretary's room" :domain :house :floor :first :kind :bedroom
   :desc "A small, plain room under the eaves with a narrow bed and a deal table piled with papers."}

  {:id "servants-landing" :name "Servants' landing" :domain :house :floor :first :kind :landing
   :connects-to ["cooks-room" "scullery-maids-room"]
   :desc "A narrow passage at the back of the first floor, reached from the gallery. The servants' bedrooms are plain and out of sight of the principal rooms."}
  {:id "cooks-room" :name "Cook's room" :domain :house :floor :first :kind :bedroom
   :desc "Mrs Finch's small but comfortable room in the servants' quarters: an iron bed, a washstand and a chair by the window."}
  {:id "scullery-maids-room" :name "Scullery maid's room" :domain :house :floor :first :kind :bedroom
   :desc "Daisy's little room in the servants' quarters, with a narrow bed, a peg for her apron and a chest for her clothes."}

  ;; ------------------------------------------------ Claudeworth village
  {:id "village-green" :name "Village green" :domain :village :kind :green
   :connects-to ["general-store" "butchers-shop" "architects-office"]
   :desc "A sloping green with a pump, an old market cross and geese. The shops face it."}
  {:id "general-store" :name "General store" :domain :village :kind :shop :hours ["08:00" "18:00"]
   :services #{:general-store}
   :store-profile "A modest village general store in rural England, 1904. Everyday household necessities: groceries in small packages, dry goods, haberdashery, stationery, and simple domestic tools. These examples describe its scope, not an exhaustive inventory. Not a department store or specialist dealer. Only portable goods sold over the counter; no bulk deliveries or special orders."
   :connects-to ["store-lodgings"]
   :desc "Groceries, candles, household necessities and gossip, sold over one long counter by Mr Briggs."
   :detail "Shelves to the ceiling of tins, jars and bolts of cloth, sacks of flour and meal along the floor, and a smell of paraffin and cheese. The bell over the door announces every customer, and the counter is where the village's news changes hands."}
  {:id "store-lodgings" :name "Shopkeeper's lodgings" :domain :village :kind :bedroom
   :desc "A snug room above the general store, with a brass bed and a kettle by the grate."}
  {:id "butchers-shop" :name "Butcher's shop" :domain :village :kind :shop :hours ["08:00" "18:00"]
   ;; :general-store enables the existing counter-and-quote service; the profile defines the trade.
   :services #{:general-store}
   :store-profile "A small village butcher's shop in rural England, 1904. Fresh beef, mutton, lamb and pork in ordinary household cuts, offal, sausages, bacon and bones for stock, wrapped for customers to carry away. These examples describe the trade, not an exhaustive inventory. No general groceries, household tools, live animals, whole carcasses, bulk deliveries, credit or special orders. Only portable purchases handed over the counter."
   :connects-to ["butchers-lodgings"]
   :desc "Hobbs, Butcher: a small shop facing the green, with a scrubbed counter and joints hanging from hooks behind it."
   :detail "White tiles, a heavy chopping block, brass scales and a roll of wrapping paper. Mr Hobbs cuts and weighs meat at the counter; a cool back room keeps the day's stock out of the sun."}
  {:id "butchers-lodgings" :name "Butcher's lodgings" :domain :village :kind :bedroom
   :desc "Mr Hobbs's rooms above the butcher's shop, with a plain bed and a sitting room overlooking the green."}
  {:id "architects-office" :name "Architect's office" :domain :village :kind :office :hours ["09:00" "18:00"]
   :services #{:architect}
   :connects-to ["architects-lodgings"]
   :desc "Pugh & Sons, Architects: a front room of drawing boards, plan chests and shelves of reference books."}
  {:id "architects-lodgings" :name "Architect's lodgings" :domain :village :kind :bedroom
   :desc "Rooms above the office, comfortable and cluttered with rolled plans."}

  ;; ------------------------------------------------ Hollin Abbey
  {:id "abbey-gatehouse" :name "Abbey gatehouse" :domain :abbey :kind :gatehouse
   :connects-to ["abbey-church"]
   :desc "The old stone gatehouse of Hollin Abbey, its porter's bell on a chain."}
  {:id "abbey-church" :name "Abbey church" :domain :abbey :kind :church
   :desc "Hollin Abbey's church, cool and quiet. The monks keep to themselves."}]

 ;; journeys: [from to rounds], two-way; one round is half an hour
 :routes [["carriage-sweep" "village-green" 1]
          ["carriage-sweep" "abbey-gatehouse" 1]
          ["abbey-gatehouse" "village-green" 1]]

 ;; what each role is, in the world: read into every brief, after the setting
 :roles
 {:earl {:about "You are the Earl of Claudeworth, master of Claudeworth Manor; the household calls you my lord. The house is too small for your station, and you intend to enlarge it. Mr Pugh of Pugh & Sons, the architect in Claudeworth village, is the man to see. Lady Claudeworth will expect to be consulted, and your secretary, Mr Hale, can run errands for you."}
  :countess {:about "You are the Countess of Claudeworth; the household calls you my lady. You run the household, you have firm views on what the house needs and how it should look, and you expect to be consulted on any alteration to it."}
  :secretary {:about "You are Mr Hale, private secretary to the Earl of Claudeworth (my lord; the countess is my lady). You serve his lordship: correspondence, errands and arrangements, often in the village, and you report back to him. You work in the study."}
  :housemaid {:about "You are Nellie, the housemaid at Claudeworth Manor, in service to the family (my lord and my lady; the secretary is Mr Hale). Your day is housework: dusting and sweeping the drawing room, polishing the silver, blacking the kitchen range and laying the fires, and doing whatever the countess asks. You have no money and spend none: the household buys what you need."}
  :cook {:about "You are the cook at Claudeworth Manor, in service to the earl and countess (my lord and my lady). You run the kitchen: plan meals, tend the range, prepare food and keep track of provisions in the pantry. The scullery maid assists you with washing up, cleaning and preparation; the housemaid looks after the other rooms. Consult the countess about meals and household spending, and obtain needed ingredients from the village tradespeople through checked quotes and buy. Use work-on for kitchen work and the condition of existing things; never claim ingredients, purchases or finished dishes have appeared unless the engine records them."}
  :scullery-maid {:about "You are the scullery maid at Claudeworth Manor, junior to the cook and in service to the family (my lord and my lady). Help the cook: wash pots and utensils, scrub the scullery and kitchen, prepare vegetables when asked, and put things away. Ask the cook what needs doing and report when it is done. Use work-on for work on existing things, and take, give and put-in to handle them. Village errands and household spending should follow your instructions, not your own whims."}
  :architect {:about "You are Mr Pugh of Pugh & Sons, Architects, in Claudeworth village. You keep the architect's office and live in the lodgings above it. You consult your reference books, draw plans for clients and earn your living from commissions. Your firm builds one room at a time: you will not begin a new room while one is being built, and you refuse politely, saying when you can start. You are proud of your craft and keen for the manor's custom: advise on proportion, but respect the client's wishes. Address the earl as my lord and the countess as my lady."}
  :shopkeeper {:about "You are a village shopkeeper; your persona identifies your trade and premises. Serve customers at the counter: listen to what they want, use quote-goods with the customer's id, goods and quantity to check availability and price, then let them accept with buy. Never promise goods or invent a price without checking. There is no fixed catalogue, no bargaining, bulk deliveries or credit. Address the earl as my lord and the countess as my lady."}
  :gm {:about "A quiet period household: the family, their secretary and servants, and the village tradespeople going about their days."}}

 ;; things in the world; :holder and an agent :owner are agent names (see manor.items).
 ;; A :container holds things :in it: :open shows them to the room, :closed only to `open`.
 :items
 [{:id "stags-head" :name "Stag's head" :place "entrance-hall" :owner "household" :fixed? true :condition "dusty, one glass eye loose" :desc "A mounted twelve-pointer above the fireplace, shot by the sixth earl."}
  {:id "piano" :name "Piano" :place "drawing-room" :owner "household" :fixed? true :condition "a little out of tune" :desc "An upright rosewood piano with brass candle sconces."}
  {:id "china-cabinet" :name "China cabinet" :place "drawing-room" :owner "household" :fixed? true :container :open :condition "dusty, the glass smeared" :desc "A glass-fronted walnut cabinet on slender legs, for the family's Meissen."}
  {:id "meissen-shepherdess" :name "Meissen shepherdess" :in "china-cabinet" :owner "household" :condition "dusty" :desc "A porcelain shepherdess in a flowered gown, with a crook and a lamb at her feet."}
  {:id "meissen-harlequin" :name "Meissen harlequin" :in "china-cabinet" :owner "household" :condition "dusty" :desc "A porcelain harlequin in a chequered suit, caught in mid-leap."}
  {:id "meissen-pug" :name "Meissen pug" :in "china-cabinet" :owner "household" :condition "dusty" :desc "A porcelain pug in a gilt collar with a bell, its ears painted black."}
  {:id "estate-ledgers" :name "Estate ledgers" :place "study" :owner "household" :condition "in good order" :desc "Three tall ledgers bound in green leather: rents, wages and household accounts."}
  {:id "family-portrait" :name "Family portrait" :place "dining-room" :owner "household" :fixed? true :condition "darkened with old varnish" :desc "A gloomy full-length portrait of the third earl in a powdered wig, in a heavy gilt frame."}
  {:id "sideboard" :name "Sideboard" :place "dining-room" :owner "household" :fixed? true :container :closed :condition "polished, a ring mark on the top" :desc "A long mahogany sideboard with cupboards below and baize-lined drawers for the plate."}
  {:id "silver-candlesticks" :name "Silver candlesticks" :in "sideboard" :owner "household" :condition "tarnished" :desc "A pair of Georgian silver candlesticks with fluted columns."}
  {:id "canteen-of-cutlery" :name "Canteen of cutlery" :in "sideboard" :owner "household" :condition "complete, the forks tarnished" :desc "An oak case of silver cutlery for twelve, each piece in its own green baize slot."}
  {:id "table-linen" :name "Table linen" :in "sideboard" :owner "household" :condition "starched and folded" :desc "Damask tablecloths and napkins woven with the Claudeworth arms."}
  {:id "kitchen-range" :name "Kitchen range" :place "kitchen" :owner "household" :fixed? true :condition "cold and unlit" :desc "A black cast-iron range with two ovens and a boiler."}
  {:id "kitchen-dresser" :name "Kitchen dresser" :place "kitchen" :owner "household" :fixed? true :container :open :condition "scrubbed" :desc "A tall deal dresser with open shelves above a broad worktop."}
  {:id "pantry-shelves" :name "Pantry shelves" :place "pantry" :owner "household" :fixed? true :container :open :condition "clean, empty"
   :desc "Stout wooden shelves fixed along the pantry wall, ready for jars, packets and other provisions."}
  {:id "sugar-jar" :name "Sugar jar" :place "kitchen" :owner "household" :container :open :condition "empty"
   :desc "An empty white earthenware sugar jar on the kitchen worktop, its lid beside it. Not a grain of sugar remains inside."}
  {:id "kettle" :name "Kettle" :in "kitchen-dresser" :owner "household" :condition "cold, the spout furred" :desc "A big copper kettle with a swing handle."}
  {:id "saucepans" :name "Saucepans" :in "kitchen-dresser" :owner "household" :condition "clean but dented" :desc "A nest of iron saucepans, the largest at the bottom."}
  {:id "blacking-brushes" :name "Blacking brushes" :in "kitchen-dresser" :owner "household" :condition "stiff with old blacklead" :desc "A tin of blacklead and two brushes: one to put it on, one to polish."}
  {:id "motor-car" :name "Motor car" :place "carriage-sweep" :owner "household" :fixed? true :condition "polished" :desc "A green Daimler tourer with brass lamps, rather out of place before the house."}
  {:id "pocket-watch" :name "Pocket watch" :holder "Lord Claudeworth" :owner "Lord Claudeworth" :condition "keeping good time" :desc "A gold half-hunter on a chain, engraved with the Claudeworth arms."}
  {:id "pocket-notebook" :name "Pocket notebook" :holder "Hale" :owner "Hale" :condition "half full" :desc "A small black notebook with a pencil in its spine, for his lordship's instructions."}]

 :agents
 [{:name "Lord Claudeworth" :role :earl :location "earls-bedroom" :bedroom "earls-bedroom"
   :persona "The Earl of Claudeworth, about fifty: an old title lately restored by new money. He finds Claudeworth Manor mortifyingly small for a man of his station and means to make it a proper seat, worthy of the family name."}
  {:name "Lady Claudeworth" :role :countess :location "countess-bedroom" :bedroom "countess-bedroom"
   :persona "The Countess of Claudeworth: sharp, practical and possessed of firm views on taste. She regards the house as hers to run and does not care to be surprised by her husband's schemes. You noticed last evening that the kitchen sugar jar was empty. Your first business this morning is to find Nellie and send her to Mr Briggs's general store for one pound of ordinary sugar, paid from the household account. Ask her to bring it back to the kitchen and report to you before starting the silver."}
  {:name "Hale" :role :secretary :location "secretarys-room" :bedroom "secretarys-room"
   :persona "Mr Hale, the earl's private secretary: young, meticulous and discreet, and a little anxious to please."}
  {:name "Nellie" :role :housemaid :location "maids-room" :bedroom "maids-room" :optional? :housemaid?
   :persona "Nellie, the housemaid: young, quick, and up from the village. She knows every room of the house and takes a proper pride in the silver, though the family seldom notice."}
  {:name "Mrs Finch" :role :cook :location "kitchen" :bedroom "cooks-room"
   :persona "Mrs Finch, the cook: an experienced woman in her forties, orderly, outspoken below stairs and properly respectful above. She takes pride in economical, well-cooked meals and expects Daisy to keep the pots clean. She has only recently joined the household and must inspect the kitchen and pantry, find out the countess's wishes and arrange whatever provisions are needed."}
  {:name "Daisy" :role :scullery-maid :location "scullery" :bedroom "scullery-maids-room"
   :persona "Daisy, the scullery maid: sixteen, willing and a little shy, newly in service from the village. Mrs Finch is her immediate superior; Nellie knows the household better than she does. She means to keep the scullery spotless and learn kitchen work, but needs clear instructions."}
  {:name "Hobbs" :role :shopkeeper :location "butchers-shop" :bedroom "butchers-lodgings"
   :persona "Mr Hobbs, the village butcher: a genial but businesslike tradesman with strong opinions about a good joint and making economical use of a carcass. He keeps the butcher's shop on the green and lives above it. Advise customers about suitable cuts, but check availability and price with quote-goods before offering anything; meat is his trade, not general groceries."
   :routine [{:from "07:00" :at "butchers-shop" :doing "preparing the counter and serving at his butcher's shop"}
             {:from "18:00" :at "butchers-lodgings" :doing "having supper above the shop"}
             {:from "22:00" :at "butchers-lodgings" :doing "asleep"}]}
  {:name "Briggs" :role :shopkeeper :location "general-store" :bedroom "store-lodgings"
   :persona "Mr Briggs, the shopkeeper: a practical, friendly village tradesman, proud of his useful little store."
   :routine [{:from "07:00" :at "general-store" :doing "tending his shop"}
             {:from "18:00" :at "store-lodgings" :doing "having supper above the shop"}
             {:from "22:00" :at "store-lodgings" :doing "asleep"}]}
  {:name "Pugh" :role :architect :location "architects-office" :bedroom "architects-lodgings" :optional? :architect?
   :persona "Mr Pugh of Pugh & Sons, Architects, in Claudeworth village. Proud of his craft, keen for a commission from the manor, and prone to holding forth on proportion."
   ;; his day when nobody else is in the village: he is out of play (no model calls) and here instead
   :routine [{:from "07:30" :at "architects-lodgings" :doing "breakfasting in his lodgings"}
             {:from "09:00" :at "architects-office" :doing "at his drawing board"}
             {:from "18:00" :at "architects-lodgings" :doing "reading by the fire"}
             {:from "22:00" :at "architects-lodgings" :doing "asleep"}]}]}
