;; Claudeworth Manor: the fresh world every :claudeworth run starts from.
;; A template: nothing writes to it. Runs keep a copy (world-start.edn) and
;; export their live map (map.edn) in this format. See docs/claudeworth-design.md.
{:meta {:name "Claudeworth Manor"
        :start "1904-10-15T08:00"
        :minutes-per-round 30
        :starting-funds 3000 ; whole pounds here; runtime money is old pence
        :positions "positions/england-1904.edn"
        :setting "Claudeworth Manor is a modest Edwardian country house, the seat of the Earls of Claudeworth, whose fortune has lately been restored. Claudeworth village lies nearby, a sloping green with a general store, a butcher's shop and the offices of Pugh & Sons, Architects. Hollin Abbey is nearby too, where the monks keep to themselves."}

 :locations
 [;; ------------------------------------------------ the manor (small to begin with)
  {:id "carriage-sweep" :name "Carriage sweep" :domain :house :floor :outside :kind :approach
   :connects-to ["entrance-hall"]
   :desc "A gravel turning circle before the front door."}
  {:id "entrance-hall" :name "Entrance hall" :domain :house :floor :ground :kind :hall
   :aspects {:cleanliness "dust in the corners" :state "hearth swept, fire unlit"}
   :connects-to ["drawing-room" "study" "dining-room" "kitchen" "staircase"]
   :desc "A modest hall with a fireplace. Doors lead to the principal rooms and the kitchen, with the bedrooms upstairs."}
  {:id "drawing-room" :name "Drawing room" :domain :house :floor :ground :kind :sitting-room
   :aspects {:cleanliness "dusty, with ash by the fender" :state "hearth cold"}
   :desc "A pleasant room with chintz chairs, though four guests would crowd it."
   :detail "Faded rose wallpaper, a white marble chimneypiece and two tall windows onto the lawn. The chintz is worn thin on the arms of the best chair, and the carpet has been turned to hide a scorch mark by the fender."}
  {:id "study" :name "Study" :domain :house :floor :ground :kind :study
   :aspects {:cleanliness "dust on the skirting boards" :state "air close with stale pipe smoke"}
   :desc "The earl's business room: a leather-topped desk and a view of the drive."
   :detail "Shelves of county histories and bound sermons that nobody reads, a map of the estate pinned above the fireplace, and a smell of pipe smoke and old leather. From the desk you can see every caller coming up the drive."}
  {:id "dining-room" :name "Dining room" :domain :house :floor :ground :kind :dining-room
   :aspects {:cleanliness "floor swept, cobwebs above the cornice" :state "hearth laid but unlit"}
   :desc "Has mahogany table for eight."}
  {:id "kitchen" :name "Kitchen" :domain :house :floor :ground :kind :kitchen
   :aspects {:cleanliness "flour dust on the floor" :state "air cold"}
   :connects-to ["maids-room" "pantry" "scullery"]
   :desc "An old kitchen with a cast-iron range, a broad worktable and a dresser. Mrs Finch, the cook, runs it; the pantry and scullery open off it."}
  {:id "pantry" :name "Pantry" :domain :house :floor :ground :kind :pantry
   :aspects {:cleanliness "floor swept" :state "cool and dry"}
   :desc "A cool pantry off the kitchen, with wooden shelves for the household's provisions and a small window shaded from the sun."}
  {:id "scullery" :name "Scullery" :domain :house :floor :ground :kind :scullery
   :aspects {:cleanliness "floor wet, sink in need of scouring"}
   :desc "A plain workroom off the kitchen, with a deep stone sink, a draining board and room for washing pots and peeling vegetables."}
  {:id "maids-room" :name "Maid's room" :domain :house :floor :ground :kind :bedroom
   :aspects {:cleanliness "swept, with dust under the bed"}
   :desc "A small room off the kitchen: a narrow bed, a chest of drawers and a window on the yard."}
  {:id "staircase" :name "Staircase" :domain :house :floor :ground :kind :stair
   :aspects {:cleanliness "dust along the stair edges"}
   :connects-to ["gallery"]
   :desc "A narrow oak staircase, creaking on the fourth step."}
  {:id "gallery" :name "First-floor gallery" :domain :house :floor :first :kind :landing
   :aspects {:cleanliness "dust on the banisters"}
   :connects-to ["earls-bedroom" "countess-bedroom" "secretarys-room" "servants-landing"]
   :desc "A short landing hung with watercolours, the bedroom doors opening off it."}
  {:id "earls-bedroom" :name "Earl's bedroom" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "carpet brushed, dust behind the curtains" :state "hearth cold"}
   :desc "A large bed with heavy curtains, a washstand and a dressing room no bigger than a cupboard."}
  {:id "countess-bedroom" :name "Countess's bedroom" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "tidy, with dust on the window ledge" :state "hearth cold"}
   :desc "A bright room with a dressing table, a writing desk and a window over the garden."}
  {:id "secretarys-room" :name "Secretary's room" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "floor swept, dust beneath the table"}
   :desc "A small, plain room under the eaves with a narrow bed and a deal table piled with papers."}

  {:id "servants-landing" :name "Servants' landing" :domain :house :floor :first :kind :landing
   :aspects {:cleanliness "boards swept"}
   :connects-to ["cooks-room" "scullery-maids-room"]
   :desc "A narrow passage at the back of the first floor, reached from the gallery. The servants' bedrooms are plain and out of sight of the principal rooms."}
  {:id "cooks-room" :name "Cook's room" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "neatly kept, washstand wiped"}
   :desc "Mrs Finch's small but comfortable room in the servants' quarters: an iron bed, a washstand and a chair by the window."}
  {:id "scullery-maids-room" :name "Scullery maid's room" :domain :house :floor :first :kind :bedroom
   :aspects {:cleanliness "swept, with dust beneath the chest"}
   :desc "Daisy's little room in the servants' quarters, with a narrow bed, a peg for her apron and a chest for her clothes."}

  ;; ------------------------------------------------ Claudeworth village
  {:id "village-green" :name "Village green" :domain :village :kind :green
   :connects-to ["general-store" "butchers-shop" "architects-office"]
   :desc "A sloping green with a pump, an old market cross and geese. The shops face it."}
  {:id "general-store" :name "General store" :domain :village :kind :shop :hours ["08:00" "18:00"]
   :services #{:general-store}
   :store-profile "A modest village general store in rural England, 1904. Everyday household necessities: groceries in small packages, dry goods, haberdashery, stationery, and simple domestic tools. These examples describe its scope, not an exhaustive inventory. Not a department store or specialist dealer. Only portable goods sold over the counter; no bulk deliveries or special orders."
   :connects-to ["store-lodgings"]
   :desc "Groceries, candles, household necessities and gossip, sold over one long counter by Mr Briggs."
   :detail "Shelves to the ceiling of tins, jars and bolts of cloth, sacks of flour and meal along the floor, and a smell of paraffin and cheese. The bell over the door announces every customer, and the counter is where the village's news changes hands."}
  {:id "store-lodgings" :name "Shopkeeper's lodgings" :domain :village :kind :bedroom
   :desc "A snug room above the general store, with a brass bed and a kettle by the grate."}
  {:id "butchers-shop" :name "Butcher's shop" :domain :village :kind :shop :hours ["08:00" "18:00"]
   ;; :general-store enables the existing counter-and-quote service; the profile defines the trade.
   :services #{:general-store}
   :store-profile "A small village butcher's shop in rural England, 1904. Fresh beef, mutton, lamb and pork in ordinary household cuts, offal, sausages, bacon and bones for stock, wrapped for customers to carry away. These examples describe the trade, not an exhaustive inventory. No general groceries, household tools, live animals, whole carcasses, bulk deliveries, credit or special orders. Only portable purchases handed over the counter."
   :connects-to ["butchers-lodgings"]
   :desc "Hobbs, Butcher: a small shop facing the green, with a scrubbed counter and joints hanging from hooks behind it."
   :detail "White tiles, a heavy chopping block, brass scales and a roll of wrapping paper. Mr Hobbs cuts and weighs meat at the counter; a cool back room keeps the day's stock out of the sun."}
  {:id "butchers-lodgings" :name "Butcher's lodgings" :domain :village :kind :bedroom
   :desc "Mr Hobbs's rooms above the butcher's shop, with a plain bed and a sitting room overlooking the green."}
  {:id "architects-office" :name "Architect's office" :domain :village :kind :office :hours ["09:00" "18:00"]
   :services #{:architect}
   :connects-to ["architects-lodgings"]
   :desc "Pugh & Sons, Architects: a front room of drawing boards, plan chests and shelves of reference books."}
  {:id "architects-lodgings" :name "Architect's lodgings" :domain :village :kind :bedroom
   :desc "Rooms above the office, comfortable and cluttered with rolled plans."}

  ;; ------------------------------------------------ Hollin Abbey
  {:id "abbey-gatehouse" :name "Abbey gatehouse" :domain :abbey :kind :gatehouse
   :connects-to ["abbey-church"]
   :desc "The old stone gatehouse of Hollin Abbey, its porter's bell on a chain."}
  {:id "abbey-church" :name "Abbey church" :domain :abbey :kind :church
   :desc "Hollin Abbey's church, cool and quiet. The monks keep to themselves."}]

 ;; journeys: [from to rounds], two-way; one round is half an hour
 :routes [["carriage-sweep" "village-green" 1]
          ["carriage-sweep" "abbey-gatehouse" 1]
          ["abbey-gatehouse" "village-green" 1]]

 ;; the positions people hold: the shared catalogue named in :meta :positions,
 ;; with these entries merged over it (see manor.positions). Duties only:
 ;; who holds them and their situations are the agents'.
 :roles
 {:secretary {:workplace ["study"]}
  :architect {:workplace ["architects-office"]}
  :shopkeeper {:workplace ["general-store"]}
  :butcher {:workplace ["butchers-shop"]}
  :gm {:about "A quiet period household: the family, their secretary and servants, and the village tradespeople going about their days."}}

 ;; things in the world; :holder and an agent :owner are agent names (see manor.items).
 ;; A :container holds things :in it: :open shows them to the room, :closed only to `open`.
 :items
 [{:id "stags-head" :name "Stag's head" :place "entrance-hall" :owner "household" :fixed? true :aspects {:cleanliness "dusty" :repair "one glass eye loose"} :desc "A mounted twelve-pointer above the fireplace, shot by the sixth earl."}
  {:id "piano" :name "Piano" :place "drawing-room" :owner "household" :fixed? true :aspects {:repair "a little out of tune"} :desc "An upright rosewood piano with brass candle sconces."}
  {:id "china-cabinet" :name "China cabinet" :place "drawing-room" :owner "household" :fixed? true :container :open :aspects {:cleanliness "dusty, the glass smeared"} :desc "A glass-fronted walnut cabinet on slender legs, for the family's Meissen."}
  {:id "meissen-shepherdess" :name "Meissen shepherdess" :in "china-cabinet" :owner "household" :aspects {:cleanliness "dusty"} :desc "A porcelain shepherdess in a flowered gown, with a crook and a lamb at her feet."}
  {:id "meissen-harlequin" :name "Meissen harlequin" :in "china-cabinet" :owner "household" :aspects {:cleanliness "dusty"} :desc "A porcelain harlequin in a chequered suit, caught in mid-leap."}
  {:id "meissen-pug" :name "Meissen pug" :in "china-cabinet" :owner "household" :aspects {:cleanliness "dusty"} :desc "A porcelain pug in a gilt collar with a bell, its ears painted black."}
  {:id "estate-ledgers" :name "Estate ledgers" :place "study" :owner "household" :aspects {:state "in good order"} :desc "Three tall ledgers bound in green leather: rents, wages and household accounts."}
  {:id "family-portrait" :name "Family portrait" :place "dining-room" :owner "household" :fixed? true :aspects {:repair "darkened with old varnish"} :desc "A gloomy full-length portrait of the third earl in a powdered wig, in a heavy gilt frame."}
  {:id "sideboard" :name "Sideboard" :place "dining-room" :owner "household" :fixed? true :container :closed :aspects {:cleanliness "polished" :repair "a ring mark on the top"} :desc "A long mahogany sideboard with cupboards below and baize-lined drawers for the plate."}
  {:id "silver-candlesticks" :name "Silver candlesticks" :in "sideboard" :owner "household" :aspects {:cleanliness "tarnished"} :desc "A pair of Georgian silver candlesticks with fluted columns."}
  {:id "canteen-of-cutlery" :name "Canteen of cutlery" :in "sideboard" :owner "household" :aspects {:state "complete" :cleanliness "the forks tarnished"} :desc "An oak case of silver cutlery for twelve, each piece in its own green baize slot."}
  {:id "table-linen" :name "Table linen" :in "sideboard" :owner "household" :aspects {:state "starched and folded"} :desc "Damask tablecloths and napkins woven with the Claudeworth arms."}
  {:id "kitchen-range" :name "Kitchen range" :place "kitchen" :owner "household" :fixed? true :aspects {:state "cold and unlit"} :desc "A black cast-iron range with two ovens and a boiler."}
  {:id "kitchen-dresser" :name "Kitchen dresser" :place "kitchen" :owner "household" :fixed? true :container :open :store {:keeps "pans, tins, cloths, crockery and kitchen tools"} :aspects {:stock "well stocked with the usual kitchen ware" :cleanliness "scrubbed"} :desc "A tall deal dresser with open shelves above a broad worktop."}
  {:id "pantry-shelves" :name "Pantry shelves" :place "pantry" :owner "household" :fixed? true :container :open :store {:keeps "dry goods, preserves, condiments, butter and cheese" :serves ["kitchen"]} :aspects {:stock "well stocked with the household's staples" :lacking "sugar"}
   :desc "Stout wooden shelves fixed along the pantry wall, ready for jars, packets and other provisions."}
  {:id "housemaids-cupboard" :name "Housemaid's cupboard" :place "maids-room" :owner "household" :fixed? true :container :closed :store {:keeps "brushes, dusters, polish and blacklead" :serves ["entrance-hall" "drawing-room" "dining-room" "kitchen"]} :aspects {:stock "well stocked with cleaning things"}
   :desc "A narrow deal cupboard by the door, for Nellie's cleaning things."}
  {:id "linen-press" :name "Linen press" :place "gallery" :owner "household" :fixed? true :container :closed :store {:keeps "sheets, pillowcases, towels and household linen"} :aspects {:stock "well stocked with clean, folded linen"}
   :desc "A tall oak press on the landing, with shelves for the household linen."}
  {:id "motor-car" :name "Motor car" :place "carriage-sweep" :owner "household" :fixed? true :aspects {:cleanliness "polished"} :desc "A green Daimler tourer with brass lamps, rather out of place before the house."}
  {:id "pocket-watch" :name "Pocket watch" :holder "Lord Claudeworth" :owner "Lord Claudeworth" :aspects {:state "keeping good time"} :desc "A gold half-hunter on a chain, engraved with the Claudeworth arms."}
  {:id "pocket-notebook" :name "Pocket notebook" :holder "Hale" :owner "Hale" :aspects {:state "half full"} :desc "A small black notebook with a pencil in its spine, for his lordship's instructions."}]

 :agents
 [{:name "Lord Claudeworth" :sex :male :role :earl :location "earls-bedroom" :bedroom "earls-bedroom"
   :situation "You are the Earl of Claudeworth, and Claudeworth Manor is your seat. The house is too small for your station, and you intend to enlarge it. Pugh, of Pugh & Sons, the architect in Claudeworth village, is the man to see. Lady Claudeworth will expect to be consulted, and your secretary, Hale, can run errands for you."
   :persona "You are about fifty, short-sighted and forever peering, and you begin every conversation yourself and keep it going. You are sure the new wing will answer and the money will come right, and you speak of it as settled. You turn your shilling over at a new moon and will not pass under a ladder, and you hold to the old ways because they did for your grandparents. You cannot see a dog go hungry, though children underfoot you cannot abide, and you measure timber by guess and always wrong."
   :sketch "The Earl of Claudeworth, about fifty: an old title lately restored by new money. Lazy and a notorious womanizer. He finds Claudeworth Manor mortifyingly small for a man of his station and means to make it a proper seat, worthy of the family name."
   :manner "You seem a genial, confident man, easy to talk to, and rather vague about figures."
   :temperament {:openness :low :conscientiousness :average :extraversion :high :agreeableness :high :neuroticism :low}
   :faculties {"Philoprogenitiveness" :small "Self-Esteem" :moderate "Hope" :large "Sight" :small "Size" :small "Tune" :moderate "Causality" :moderate}
   :circumstances ["superstitious"]}
  {:name "Lady Claudeworth" :sex :female :role :countess :location "countess-bedroom" :bedroom "countess-bedroom"
   :situation "You are the Countess of Claudeworth, and Claudeworth Manor's household is yours to run. You expect to be consulted on what the house needs, how it should look and any alteration to it. Your first concern is that the house runs smoothly and in good order."
   :persona "You are the Countess, near fifty, short-sighted and forever peering at things; you cut a cake too generous or too mean for want of an eye for measure. You read whatever comes to hand and remember the best of it, yet keep to the background and stir no finger for another without cause. Your temper breaks crockery, Saturday's decanter goes round once too often, and you lie awake over trifles. Church and Crown, and every penny watched."
   :sketch "The Countess of Claudeworth: sharp, practical and possessed of firm views on taste. Easily angered, and she takes it out on her servants. She regards the house as hers to run and does not care to be surprised by her husband's schemes. Her first order of business is to make sure the house is running smoothly and orderly."
   :manner "You seem a quiet, peering woman in good black until something vexes you, and then your voice carries through the house."
   :temperament {:openness :high :conscientiousness :average :extraversion :low :agreeableness :low :neuroticism :high}
   :faculties {"Destructiveness" :large "Cautiousness" :moderate "Hope" :small "Sight" :small "Size" :small "Time" :moderate "Comparison" :small}
   :circumstances ["drinks" "Church and King"]}
  {:name "Hale" :sex :male :role :secretary :location "secretarys-room" :bedroom "secretarys-room"
   :situation "You are private secretary to Lord Claudeworth, the Earl of Claudeworth, at Claudeworth Manor."
   :persona "You are a young man in a decent dark coat, neat to the button, with a tin of savings hidden under the floorboards and every penny entered in a little book. You go to chapel twice on Sundays and purse your lips at cards and the public house, yet you will talk to anyone you meet and think well of them before they have finished speaking. You read whatever is left lying about, expect the worst of every plan, lose your way in strange lanes, and flare up hot, then go quiet and sorry. A word of praise will keep you at the desk past midnight."
   :sketch "Mr Hale, the earl's private secretary: young, meticulous and discreet, and a little anxious to please."
   :manner "You seem eager and precise at first, a little anxious to please, and you smile rather too quickly."
   :temperament {:openness :high :conscientiousness :average :extraversion :high :agreeableness :high :neuroticism :high}
   :faculties {"Acquisitiveness" :large "Love of Approbation" :large "Hope" :small "Smell" :moderate "Individuality" :small "Locality" :small "Comparison" :large}
   :circumstances ["left the last place under a cloud" "chapel"]}
  {:name "Nellie" :sex :female :role :housemaid :location "maids-room" :bedroom "maids-room" :optional? :housemaid?
   :situation "You are the housemaid at Claudeworth Manor."
   :persona "You are a young housemaid up from the village, quick on the stairs and proud of the silver nobody thanks you for. You bolt the back door twice of a night and cannot tell beef from mutton. You hum at your dusting, lose your thimble weekly, and go quiet as a mouse when the family comes in, though you'd give your tea to a hungry dog. Sunday is the same road and pew; your spirits ride the weather."
   :sketch "Nellie, the housemaid: young, quick, and up from the village. Somewhat naive and foolish. She knows every room of the house and takes a proper pride in the silver, though the family seldom notice."
   :manner "You seem a plain, willing girl at the back door, but go shy and tongue-tied in the drawing-room, twisting your apron."
   :temperament {:openness :low :conscientiousness :low :extraversion :low :agreeableness :high :neuroticism :high}
   :faculties {"Concentrativeness" :moderate "Cautiousness" :large "Hope" :moderate "Taste" :small "Form" :moderate "Tune" :large "Causality" :moderate}
   :circumstances ["a farm labourer's child"]}
  {:name "Mrs Finch" :sex :female :role :cook :location "kitchen" :bedroom "cooks-room"
   :situation "You are the cook at Claudeworth Manor, and you have only recently joined the household: inspect the kitchen and pantry, find out the countess's wishes and arrange whatever provisions are needed."
   :persona "You are in your forties, quick and neat in a clean apron, with a kitchen that must be just so and a place for every ladle. You hunger for a word of praise from the countess but will let an argument go rather than cross swords, and you keep your opinions on parsons to yourself when the quality are near. You have never lost your way to a market town in your life, know every lane and short cut, and watch once, then copy a method exactly. You cannot match a ribbon to a dishcloth to save your life."
   :sketch "Mrs Finch, the cook: an experienced woman in her forties, orderly, outspoken below stairs and properly respectful above. She takes pride in economical, well-cooked meals and expects Daisy to keep the pots clean. She has only recently joined the household and must inspect the kitchen and pantry, find out the countess's wishes and arrange whatever provisions are needed."
   :manner "You seem brisk and obliging, putting a stranger at ease, though you would sooner walk the long way than stop and gossip."
   :temperament {:openness :average :conscientiousness :high :extraversion :low :agreeableness :high :neuroticism :low}
   :faculties {"Combativeness" :small "Love of Approbation" :large "Imitation" :moderate "Feeling" :moderate "Colouring" :small "Locality" :large "Causality" :moderate}
   :circumstances ["a free-thinker"]}
  {:name "Daisy" :sex :female :role :scullery-maid :location "scullery" :bedroom "scullery-maids-room"
   :situation "You are the scullery maid at Claudeworth Manor."
   :persona "You are sixteen, small and quick, apron always damp, nose sharp enough to smell burnt milk before the pan does. Always peckish, you know the larder in the dark. Praise goes to your head; you'd sooner be thought clever than rested, and can mimic Mrs Finch to the life behind her back. Sunny till a sharp word, then you flare and are sorry at once. Each month you take a few shillings to a woman in another parish and tell no one here."
   :sketch "Daisy, the scullery maid: sixteen, willing and a little shy, newly in service from the village. Mrs Finch is her immediate superior; Nellie knows the household better than she does. She means to keep the scullery spotless and learn kitchen work, but needs clear instructions."
   :manner "You seem a shy, tidy little thing at the door, then talk nineteen to the dozen once the pots are warm."
   :temperament {:openness :average :conscientiousness :average :extraversion :high :agreeableness :high :neuroticism :high}
   :faculties {"Alimentiveness" :large "Love of Approbation" :large "Imitation" :large "Smell" :large "Individuality" :moderate "Order" :moderate "Causality" :moderate}
   :circumstances ["a child put out to nurse"]}
  {:name "Hobbs" :sex :male :role :butcher :location "butchers-shop" :bedroom "butchers-lodgings"
   :situation "You keep the butcher's shop on Claudeworth's village green, and live above it."
   :persona "You are a broad, red-faced man of forty-odd who fills a doorway and a conversation alike, laughing loud at breakfast and quiet by tea. You are never late and never behindhand, and keep a sharp eye down the green for anyone idle. Your shop is swept, your blocks scrubbed, your string and paper counted out. You have no patience for a pretty thing that does no work, and no time for a neighbour's errand; but you find your way down every lane in the dark, remember a face from years back, and slip off to see your girl whenever the counter is quiet."
   :sketch "Mr Hobbs, the village butcher: a genial but businesslike tradesman with strong opinions about a good joint and making economical use of a carcass. He keeps the butcher's shop on the green and lives above it. Advise customers about suitable cuts, but check availability and price with quote-goods before offering anything; meat is his trade, not general groceries."
   :manner "You seem a hearty, plain-spoken tradesman, quick with a joke and quicker to name a price."
   :temperament {:openness :average :conscientiousness :high :extraversion :high :agreeableness :low :neuroticism :high}
   :faculties {"Alimentiveness" :moderate "Self-Esteem" :moderate "Ideality" :small "Sight" :large "Form" :large "Locality" :large "Comparison" :moderate}
   :circumstances ["a sweetheart in the village"]
   :routine [{:from "07:00" :at "butchers-shop" :doing "preparing the counter and serving at his butcher's shop"}
             {:from "18:00" :at "butchers-lodgings" :doing "having supper above the shop"}
             {:from "22:00" :at "butchers-lodgings" :doing "asleep"}]}
  {:name "Briggs" :sex :male :role :shopkeeper :location "general-store" :bedroom "store-lodgings"
   :situation "You keep the general store on Claudeworth's village green, and live above it."
   :persona "You are a shopkeeper of forty-odd, proud of your counter and slow to let anyone look down on it, though respectful enough to the gentry and in church most Sundays. Your hands are hard and half-numb, so you bungle any mending and pay a man to do it. You write a fine round hand and can tell one blue ribbon from another by lamplight. Saturday nights you take a drop too much; ordinary days you shirk the ledgers till someone comes."
   :sketch "Mr Briggs, the shopkeeper: a practical, friendly village tradesman, proud of his useful little store."
   :manner "You answer strangers shortly at first, then warm and talk their ear off."
   :temperament {:openness :average :conscientiousness :low :extraversion :low :agreeableness :average :neuroticism :low}
   :faculties {"Constructiveness" :small "Self-Esteem" :large "Veneration" :moderate "Feeling" :small "Colouring" :large "Language" :large "Comparison" :large}
   :circumstances ["reads and writes well" "drinks"]
   :routine [{:from "07:00" :at "general-store" :doing "tending his shop"}
             {:from "18:00" :at "store-lodgings" :doing "having supper above the shop"}
             {:from "22:00" :at "store-lodgings" :doing "asleep"}]}
