  {:id "butchers-counter" :name "Butcher's counter" :place "butchers-shop" :owner "Hobbs" :fixed? true :aspects {:cleanliness "scrubbed"} :desc "A stout wooden counter where Mr Hobbs cuts and weighs meat for his customers."}
