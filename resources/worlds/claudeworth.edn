  {:id "barbers-shelf" :name "Barber's shelf" :place "barbers-cottage" :owner "Webb" :fixed? true :store {:keeps "scissors, combs, razors, strop, shaving soap, towels and hair brushes"} :aspects {:stock "the usual barber's equipment to hand"} :desc "A narrow shelf beside the mirror, with a drawer beneath for the barber's working things."}
