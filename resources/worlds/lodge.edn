;; Ashby Lodge: a small household for quick checks of production mechanics.
;; All connections are free walks, including the shop across the street.
{:meta {:name "Ashby Lodge"
        :start "1904-10-15T08:00"
        :minutes-per-round 30
        :starting-funds 20 ; whole pounds; runtime money is old pence
        :positions "positions/england-1904.edn"
        :setting "Ashby Lodge is a small house on a village street in rural England, 1904. Ashby, a widow, keeps it with her cook-general, Bell. The housemaid gave notice and left last night; a girl is wanted, and the maid's room is empty. Ward keeps the general shop just across the street and knows the village. The front gate is where callers meet the household. House and shop are all within easy walking distance. There is no architect or architect's office here."}

 :locations
 [{:id "front-gate" :name "Front gate" :domain :house :floor :outside :kind :approach
   :connects-to ["hall" "general-store"]
   :desc "A low iron gate opening straight onto the village street, where callers wait."}
  {:id "hall" :name "Hall" :domain :house :floor :ground :kind :hall
   :connects-to ["parlour" "kitchen" "mistress-bedroom"]
   :aspects {:cleanliness "dust along the skirting"}
   :desc "A narrow hall with coat pegs and the stairs to the mistress's room."}
  {:id "parlour" :name "Parlour" :domain :house :floor :ground :kind :sitting-room
   :aspects {:cleanliness "dust on the mantel" :state "hearth laid but unlit"}
   :desc "A small parlour with two armchairs, a writing desk and a table for meals."}
  {:id "kitchen" :name "Kitchen" :domain :house :floor :ground :kind :kitchen
   :connects-to ["maids-room" "cooks-room"]
   :aspects {:cleanliness "crumbs on the floor"}
   :desc "A kitchen with a little range, a dresser and a provisions cupboard. The servants' rooms open off the back passage."}
  {:id "mistress-bedroom" :name "Mistress's bedroom" :domain :house :floor :first :kind :bedroom
   :desc "A plain comfortable bedroom above the parlour, with a brass bed and washstand."}
  {:id "maids-room" :name "Maid's room" :domain :house :floor :ground :kind :bedroom
   :aspects {:cleanliness "swept, with dust beneath the bed" :state "bed stripped, unoccupied"}
   :desc "A narrow room with one iron bed and an empty chest. The housemaid left last night."}
  {:id "cooks-room" :name "Cook's room" :domain :house :floor :ground :kind :bedroom
   :desc "A small room behind the kitchen, with a bed, a washstand and a peg for an apron."}
  {:id "general-store" :name "Village shop" :domain :village :kind :shop
   :hours ["08:00" "18:00"] :services #{:general-store}
   :connects-to ["shop-lodgings"]
   :store-profile "A small village general shop in rural England, 1904. Groceries in household quantities, dry goods, haberdashery, stationery and simple domestic tools. These describe its scope, not an exhaustive inventory. Only ordinary portable purchases over the counter; no specialist goods, bulk deliveries, credit or special orders."
   :desc "A little general shop across the street from the lodge, with a bell over the door and news at the counter."}
  {:id "shop-lodgings" :name "Shopkeeper's lodgings" :domain :village :kind :bedroom
   :desc "A bed-sitting room above the shop, overlooking the lodge gate."}]

 :roles
 {:mistress {:workplace ["parlour"]}
  :cook-general {:workplace ["kitchen"]}
  :shopkeeper {:workplace ["general-store"]}
  :gm {:about "A small village household going about its day; a maid is wanted. Hiring is not yet implemented: do not invent candidates or claim anyone has been hired."}}

 :items
 [{:id "kitchen-range" :name "Kitchen range" :place "kitchen" :owner "household" :fixed? true
   :aspects {:state "cold and unlit" :cleanliness "needs blacking"}
   :desc "A small cast-iron range with an oven and a hotplate."}
  {:id "provisions-cupboard" :name "Provisions cupboard" :place "kitchen" :owner "household" :fixed? true :container :closed
   :store {:keeps "flour, sugar, tea, preserves, butter, cheese and other everyday provisions"}
   :aspects {:stock "enough of the usual staples" :lacking "tea"}
   :desc "A cool cupboard with shelves for packets, jars and crocks."}
  {:id "kitchen-dresser" :name "Kitchen dresser" :place "kitchen" :owner "household" :fixed? true :container :open
   :store {:keeps "pans, crockery, cloths and kitchen tools"}
   :desc "A deal dresser with cups on hooks and pans on its lower shelves."}
  {:id "cleaning-cupboard" :name "Cleaning cupboard" :place "hall" :owner "household" :fixed? true :container :closed
   :store {:keeps "brushes, dusters, soap, polish, blacklead and household linen" :serves ["parlour" "kitchen" "mistress-bedroom" "maids-room" "cooks-room"]}
   :desc "A narrow cupboard under the stairs, for cleaning things and folded linen."}
  {:id "candlesticks" :name "Brass candlesticks" :place "parlour" :owner "household"
   :aspects {:cleanliness "tarnished"}
   :desc "A pair of plain brass candlesticks on the mantel."}]

 :agents
 [{:name "Mrs Ashby" :sex :female :role :mistress :location "parlour" :bedroom "mistress-bedroom"
   :situation "You keep Ashby Lodge with Bell, your cook-general. The housemaid gave notice and left last night. You want a girl for the housemaid's place; her room stands empty. Ward at the shop across the street knows everyone: ask there early. For now you can discuss the vacancy, but finding and engaging candidates are not yet supported."
   :persona "You are a widow of about fifty, keeping a small house on the village street on a modest income."}
  {:name "Mrs Bell" :sex :female :role :cook-general :location "kitchen" :bedroom "cooks-room"
   :situation "You are the cook-general at Ashby Lodge. The housemaid left last night, so the housework falls on you until Ashby finds another girl. Breakfast needs seeing to, and the provisions cupboard is short of tea."
   :persona "You are about forty, the cook-general at a small village house, with a room behind the kitchen."}
  {:name "Ward" :sex :male :role :shopkeeper :location "general-store" :bedroom "shop-lodgings"
   :situation "You keep the shop across the street from Ashby Lodge and live above it. You know the village households and hear their news at the counter. Ashby's housemaid left last night. For now you can discuss the vacancy, but recommending actual candidates is not yet supported."
   :persona "You are a village shopkeeper of about fifty, long established at the counter, acquainted with everyone in the village."}]}
