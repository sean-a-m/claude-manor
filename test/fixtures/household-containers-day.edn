   [:spend-time {:doing "writing letters", :hours 1.5}]],
  "13:30" [[:travel {:to "abbey-church"}]],
  "16:30" [[:accept-offer {:item "feather duster"}]],
  "08:00"
  [[:walk {:to "dining-room"}]
   [:converse
    {:with ["lord-claudeworth"],
     :text
     "Enlarge it? Then I expect to be consulted on every room, Claudeworth."}]],
  "15:30" [[:travel {:to "general-store"}]],
  "19:30"
  [[:walk {:to "dining-room"}]
   [:spend-time {:doing "dining", :hours 2}]],
  "09:30"
  [[:open {:container "sideboard"}]
   [:take {:item "silver-candlesticks"}]
   [:walk {:to "drawing-room"}]
   [:put-down {:item "silver-candlesticks"}]
   [:look {}]
   [:call
    {:text
     "Nellie! The candlesticks are in the drawing room when you have a moment.",
     :to "nellie"}]
   [:spend-time
    {:doing "going over the household accounts", :hours 4}]]},
 "hale"
 {"18:00" [[:spend-time {:doing "copying letters", :hours 2}]],
  "22:00" [[:walk {:to "secretarys-room"}] [:sleep {:until "06:30"}]],
  "12:30" [[:accept-offer {:item "tin of silver polish"}]],
  "14:00"
  [[:walk {:to "study"}]
   [:spend-time {:doing "filing correspondence", :hours 4}]],
  "11:30" [[:travel {:to "general-store"}]],
  "08:30" [[:spend-time {:doing "breakfasting", :hours 1}]],
  "12:00" [[:request-goods {:item "tin of silver polish", :qty 1}]],
  "06:30"
  [[:walk {:to "earls-bedroom"}]
   [:rouse {:who "lord-claudeworth"}]
   [:say {:text "Good morning, my lord. It is half past six."}]],
  "20:00" [[:spend-time {:doing "reading", :hours 2}]],
  "13:30"
  [[:walk {:to "dining-room"}]
   [:spend-time {:doing "lunching", :hours 0.5}]],
  "08:00"
  [[:walk {:to "dining-room"}]
   [:say {:text "Good morning, my lord. Good morning, my lady."}]],
  "13:00" [[:travel {:to "carriage-sweep"}]],
  "09:30"
  [[:walk {:to "study"}]
   [:spend-time {:doing "writing letters", :hours 2}]]},
 "nellie"
 {"08:00"
  [[:walk {:to "kitchen"}]
   [:say {:text "Morning. Fires, then the dining room."}]],
  "09:00"
  [[:walk {:to "dining-room"}]
   [:spend-time
    {:on ["family-portrait"],
     :doing "dusting the dining room and the portrait",
     :hours 1}]],
  "10:00"
