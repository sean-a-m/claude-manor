    {:on ["entrance-hall" "stags-head"],
     :doing "dusting the hall and the stag's head",
     :hours 1}]],
  "14:30" [[:walk {:to "drawing-room"}]],
  "18:00"
  [[:spend-time
    {:on ["china-cabinet"],
     :doing
     "dusting the china cabinet and the glass with her new duster",
     :hours 1}]],
  "21:30" [[:walk {:to "maids-room"}] [:sleep {:until "06:30"}]]},
 "pugh"
 {"09:00" [[:walk {:to "architects-office"}] [:pass {}]],
  "18:00"
  [[:walk {:to "architects-lodgings"}]
