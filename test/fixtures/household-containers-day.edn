  "17:30" [[:spend-time {:doing "tidying the office", :hours 0.5}]],
  "13:30"
  [[:walk {:to "architects-office"}]
   [:spend-time {:doing "at his drawing board", :hours 4}]],
  "08:00"
  [[:walk {:to "architects-lodgings"}]
   [:spend-time {:doing "breakfasting", :hours 1}]],
  "10:00"
  [[:consult-references {:query "library study"}]
   [:price-list {}]
   [:say
    {:text
     "An honour, my lord. A library on the garden side would answer admirably, provided we mind the proportions."}]],
  "10:30"
  [[:draw-plans
    {:for "lord-claudeworth",
     :name "Library",
     :floor "ground",
     :desc "A panelled library with shelves and a reading table.",
