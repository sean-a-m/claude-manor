;; Fixed container choreography; do not sync with bundled content.
{"lord-claudeworth"
 {"18:00"
  [[:walk {:to "drawing-room"}]
   [:say
    {:text
     "Pugh is keen. He talks a great deal about proportion, but I think he is our man."}]],
  "18:30"
  [[:walk {:to "dining-room"}]
   [:spend-time {:doing "dining", :hours 2}]],
  "14:00"
  [[:walk {:to "study"}]
   [:spend-time {:doing "reading the newspapers", :hours 4}]],
  "11:30" [[:travel {:to "carriage-sweep"}]],
  "08:30" [[:spend-time {:doing "breakfasting", :hours 1}]],
  "12:00"
  [[:walk {:to "study"}]
   [:spend-time {:doing "attending to estate business", :hours 1}]],
  "11:00" [[:commission {:plan-id "library"}]],
  "07:00" [[:say {:text "Thank you, Hale. Another day of it, then."}]],
  "22:30" [[:walk {:to "earls-bedroom"}] [:sleep {:until "07:30"}]],
  "08:00"
  [[:walk {:to "dining-room"}]
   [:say
    {:text
     "I have made up my mind: this house is too small for us, and I mean to enlarge it. I shall see Pugh, the architect, this morning."}]],
  "10:00"
  [[:say
    {:text
     "Good morning, Mr Pugh. I want Claudeworth made a proper seat: a library to begin with. What do you advise?"}]],
  "13:00"
  [[:walk {:to "dining-room"}]
   [:spend-time {:doing "lunching", :hours 1}]],
  "10:30"
  [[:say
    {:text
     "A library beside the study, then. Please draw it for me."}]],
  "20:30"
  [[:walk {:to "drawing-room"}]
   [:spend-time {:doing "smoking a cigar over a novel", :hours 2}]],
  "09:30" [[:travel {:to "architects-office"}]]},
 "lady-claudeworth"
 {"17:00" [[:travel {:to "carriage-sweep"}]],
  "16:00" [[:request-goods {:item "feather duster", :qty 1}]],
  "14:00"
  [[:spend-time
    {:doing "sitting quietly in the abbey church", :hours 1.5}]],
  "08:30" [[:spend-time {:doing "breakfasting", :hours 1}]],
  "19:00"
  [[:say
    {:text
     "I hope Mr Pugh understands that the drawing room is mine to decide."}]],
  "21:30"
  [[:walk {:to "drawing-room"}]
   [:spend-time {:doing "reading a novel", :hours 1}]],
  "22:30" [[:walk {:to "countess-bedroom"}] [:sleep {:until "07:30"}]],
  "17:30"
  [[:walk {:to "drawing-room"}]
